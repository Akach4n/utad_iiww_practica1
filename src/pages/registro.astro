---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Registro">
  <section class="tarjeta mx-auto max-w-sm p-8">
    <h1 class="text-2xl font-bold">Crear cuenta</h1>
    <p class="mb-6 text-sm text-slate-400">Únete a la comunidad de Vidora.</p>

    <!-- Prototipo: al enviar se simula el registro y se va al feed -->
    <form action="/feed" method="get" class="space-y-4">
      <p>
        <label for="fullName" class="etiqueta">Nombre completo</label>
        <input type="text" id="fullName" name="fullName" required class="campo" />
      </p>
      <p>
        <label for="userName" class="etiqueta">Nombre de usuario</label>
        <input type="text" id="userName" name="userName" required class="campo" />
      </p>
      <p>
        <label for="email" class="etiqueta">Correo electrónico</label>
        <input type="email" id="email" name="email" required class="campo" />
      </p>
      <p>
        <label for="birthDate" class="etiqueta">Fecha de nacimiento</label>
        <input type="date" id="birthDate" name="birthDate" required class="campo" />
      </p>
      <p>
        <label for="password" class="etiqueta">Contraseña</label>
        <input type="password" id="password" name="password" minlength="8" required class="campo" />
      </p>
      <button type="submit" class="btn w-full">Crear cuenta</button>
    </form>

    <p class="mt-6 text-center text-sm">¿Ya tienes cuenta? <a href="/login" class="font-semibold text-violet-400 hover:underline">Inicia sesión</a></p>
  </section>
</Layout>
