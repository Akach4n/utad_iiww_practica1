---
import IconoPlay from './IconoPlay.astro';
import { usuarioActual, avatar } from '../data/datos';

const enlaces = [
  { href: '/', texto: 'Inicio' },
  { href: '/feed', texto: 'Feed' },
  { href: '/subir', texto: 'Subir vídeo' },
  { href: '/login', texto: 'Iniciar sesión' },
  { href: '/registro', texto: 'Registrarse' },
];

const ruta = Astro.url.pathname;
---

<header class="sticky top-0 z-10 border-b border-slate-800 bg-slate-950/80 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl flex-wrap items-center gap-6 px-4 py-3">
    <a href="/" class="flex items-center gap-2 text-xl font-extrabold">
      <IconoPlay class="size-8" />
      Vidora
    </a>
    <ul class="flex flex-wrap gap-1 text-sm font-medium">
      {
        enlaces.map((e) => (
          <li>
            <a
              href={e.href}
              class:list={['rounded-md px-3 py-1.5 transition', ruta === e.href ? 'bg-violet-500/15 text-violet-300' : 'text-slate-400 hover:bg-slate-800']}
            >
              {e.texto}
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/feed" class="ml-auto flex items-center gap-2 rounded-md py-1 pr-3 pl-1 text-sm font-semibold hover:bg-slate-800">
      <img src={avatar(usuarioActual, 32)} alt="" width="32" height="32" class="rounded-full" />
      {usuarioActual.fullName}
    </a>
  </nav>
</header>
